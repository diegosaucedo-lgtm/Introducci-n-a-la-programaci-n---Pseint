Algoritmo introducción
	// Las operaciones básicas en Pseint
	Definir a,b Como Entero
	
	Escribir "Ingresa el primer valor: "
	Leer a
	
	Escribir "Ingresa el segundo valor: "
	Leer b
	
	Escribir "---------------------------------------"
	Escribir a," + ",b," = ",a+b
	Escribir a," - ",b," = ",a-b
	Escribir a," x ",b," = ",a*b
	Escribir a," / ",b," = ",a/b
	Escribir "---------------------------------------"
	Escribir "Potencia: ",a^b
	Escribir "Residuo: ",a MOD b
	Escribir "Parte entera del decimal: ",trunc(a/b)
	
	
	
FinAlgoritmo
