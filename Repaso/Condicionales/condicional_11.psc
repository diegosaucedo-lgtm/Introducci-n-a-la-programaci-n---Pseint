Algoritmo s05
	
	Definir n Como Entero
	Definir t Como Caracter
	Escribir Sin Saltar "Ingrese un numero positivo"
	Leer n
	
	t="es multiplo de 7"
	//	Si Entonces funciona como una reconfirmacion de la afirmacion puesta lineas arriba
	
	Si (n MOD 7)<>0 Entonces
		t="no es multiplo de 7"
	Fin Si
	
	Escribir "El numero ",n," ",t
	
	//Ctrl+D vuelve el codigo en comentarios. Primero debes selecionar lo que se desea convertir.
	//Ctrl+shift+D revierte lo dicho anteriormente. 
	
	
	
	
	
FinAlgoritmo
