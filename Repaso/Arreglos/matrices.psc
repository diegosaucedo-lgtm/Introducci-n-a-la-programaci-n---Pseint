Algoritmo matrices
	
	Definir matriz,i,j,num Como Entero
	
	Dimension matriz[2,2] //Filas , columnas
	
	Para i=1 Hasta 2 Con Paso 1 Hacer
		Para j=1 Hasta 2 Con Paso 1 Hacer
			Escribir "Ingresa el numero a la matriz: "
			Leer num 
			matriz[i,j]=num
		Fin Para
	Fin Para
	
FinAlgoritmo
