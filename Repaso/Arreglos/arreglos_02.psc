Algoritmo s16II_arreglos
	//Declarar variable
	Definir empleado Como Caracter
	Definir i Como Entero
	//Convertir a arreglo
	dimension empleado[5]
	
	Para i=1 Hasta 5 Con Paso 1 Hacer
		Escribir "Escribir el empleado ",i," : "
		Leer empleado[i]
	Fin Para
	
	Para i=1 Hasta 5 Con Paso 1 Hacer
		Escribir "empleado ",empleado[i]
	Fin Para
	
	
	
	
	
FinAlgoritmo
